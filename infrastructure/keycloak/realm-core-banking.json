{
  "realm": "core-banking",
  "enabled": true,
  "displayName": "Core Banking Local Prototype",
  "roles": {"realm": [
    {"name":"platform-operator","description":"May provision local demo ledger accounts and simulated funding"},
    {"name":"ledger-poster","description":"May submit financial postings through the Transfer Service identity"}
  ]},
  "clients": [
    {
      "clientId": "banking-local",
      "name": "Local prototype client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*"]
    },
    {
      "clientId": "transfer-service",
      "name": "Transfer to Ledger service identity",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "transfer-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {"id":"11111111-1111-4111-8111-111111111111","username":"alice","firstName":"Alice","lastName":"Demo","email":"alice@example.local","enabled":true,"emailVerified":true,"credentials":[{"type":"password","value":"alice-local-password","temporary":false}]},
    {"id":"22222222-2222-4222-8222-222222222222","username":"bob","firstName":"Bob","lastName":"Demo","email":"bob@example.local","enabled":true,"emailVerified":true,"credentials":[{"type":"password","value":"bob-local-password","temporary":false}]},
    {"id":"33333333-3333-4333-8333-333333333333","username":"operator","firstName":"Platform","lastName":"Operator","email":"operator@example.local","enabled":true,"emailVerified":true,"credentials":[{"type":"password","value":"operator-local-password","temporary":false}],"realmRoles":["platform-operator"]},
    {"username":"service-account-transfer-service","enabled":true,"serviceAccountClientId":"transfer-service","realmRoles":["ledger-poster"]}
  ]
}
