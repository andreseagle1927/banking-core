{
  "realm": "core-banking",
  "enabled": true,
  "displayName": "Core Banking Local Prototype",
  "roles": {
    "realm": [
      {
        "name": "platform-operator",
        "description": "May provision local demo ledger accounts and simulated funding"
      },
      {
        "name": "ledger-poster",
        "description": "May submit financial postings through the Transfer Service identity"
      },
      {
        "name": "wallet-provisioner",
        "description": "May create and control wallet ledger accounts"
      },
      {
        "name": "wallet-reader",
        "description": "May read wallet currency balances"
      },
      {
        "name": "loan-underwriter",
        "description": "May query customer status and post loan journal entries"
      },
      {
        "name": "loan-poster",
        "description": "May post loan disbursements and repayments"
      },
      {
        "name": "notification-reader",
        "description": "May query customer contact details for local delivery"
      }
    ]
  },
  "clients": [
    {
      "clientId": "banking-local",
      "name": "Local prototype client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:*"
      ]
    },
    {
      "clientId": "transfer-service",
      "name": "Transfer to Ledger service identity",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "transfer-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "wallet-service",
      "name": "Wallet Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "wallet-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "loan-service",
      "name": "Loan Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "loan-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "notification-service",
      "name": "Notification Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "notification-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Demo",
      "email": "alice@example.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-local-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Demo",
      "email": "bob@example.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-local-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "operator",
      "firstName": "Platform",
      "lastName": "Operator",
      "email": "operator@example.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "operator-local-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-operator"
      ]
    },
    {
      "username": "service-account-transfer-service",
      "enabled": true,
      "serviceAccountClientId": "transfer-service",
      "realmRoles": [
        "ledger-poster"
      ]
    },
    {
      "username": "service-account-wallet-service",
      "enabled": true,
      "serviceAccountClientId": "wallet-service",
      "realmRoles": [
        "wallet-provisioner",
        "wallet-reader"
      ]
    },
    {
      "username": "service-account-loan-service",
      "enabled": true,
      "serviceAccountClientId": "loan-service",
      "realmRoles": [
        "loan-underwriter",
        "loan-poster"
      ]
    },
    {
      "username": "service-account-notification-service",
      "enabled": true,
      "serviceAccountClientId": "notification-service",
      "realmRoles": [
        "notification-reader"
      ]
    }
  ]
}
