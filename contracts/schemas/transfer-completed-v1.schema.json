{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.core-banking.local/schemas/transfer-completed-v1.schema.json",
  "title": "TransferCompleted v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "aggregateId", "occurredAt", "correlationId", "senderWalletId", "recipientWalletId", "amount", "currency", "ledgerTransactionId"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "TransferCompleted"},
    "schemaVersion": {"const": 1},
    "aggregateId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "correlationId": {"type": "string", "format": "uuid"},
    "senderWalletId": {"type": "string", "format": "uuid"},
    "recipientWalletId": {"type": "string", "format": "uuid"},
    "amount": {"type": "string", "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "ledgerTransactionId": {"type": "string", "format": "uuid"}
  }
}
